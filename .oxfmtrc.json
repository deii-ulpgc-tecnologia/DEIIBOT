{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "lf",
    "sortPackageJson": true,
    "ignorePatterns": ["dist/**", "node_modules/**", ".agents/**", "pnpm-lock.yaml", "LICENSE.md"]
}

{
    "compilerOptions": {
        "target": "es2025",
        "module": "nodenext",
        "types": ["node"],
        "rootDir": "./src",
        "outDir": "./dist",
        "removeComments": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "moduleResolution": "nodenext",
        "paths": {
            "@/*": ["./src/*"],
            "@services/*": ["./src/services/*"],
            "@config/*": ["./src/config/*"]
        }
    },
    "exclude": ["dist", "node_modules", "tests"]
}
